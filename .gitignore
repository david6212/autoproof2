# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase local deploy cache (regenerated on every deploy)
.firebase/

# Office temp / lock files (e.g. ~$Document.docx)
~$*

# Android release signing. The keystore IS the app's identity — an update
# signed with a different key is refused by Android — so it lives outside
# the repo and is backed up separately. See DEVELOPMENT_LOG / README.
android/key.properties
*.jks
*.keystore
