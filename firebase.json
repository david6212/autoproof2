{
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "autoproof-8d827",
          "configurations": {
            "android": "1:424043770826:android:2423b7e09e8f3290ae5533",
            "ios": "1:424043770826:ios:47d76ca308c225ebae5533",
            "macos": "1:424043770826:ios:47d76ca308c225ebae5533",
            "web": "1:424043770826:web:e9c1995112bf1c0aae5533",
            "windows": "1:424043770826:web:8a37c297656410bcae5533"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "autoproof-8d827",
          "appId": "1:424043770826:android:2423b7e09e8f3290ae5533",
          "fileOutput": "android/app/google-services.json"
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "//": "Canonical site - https://otov.web.app. Serves the static landing page at / and the Flutter app at /app/, assembled into build/hosting by tool/build_site.sh.",
      "site": "otov",
      "public": "build/hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "/app/**",
          "destination": "/app/index.html"
        }
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/app/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/app/index.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/app/flutter_service_worker.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "//": "Old URL from the AutoProof days. The project ID cannot be renamed, so instead of serving the app it now forwards to otov.web.app — old links keep working AND the address bar updates itself. The #/route fragment is preserved by the browser across the redirect.",
      "site": "autoproof-8d827",
      "public": "build/hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "source": "**",
          "destination": "https://otov.web.app",
          "type": 301
        }
      ]
    }
  ]
}
