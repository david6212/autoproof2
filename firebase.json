          "configurations": {
            "android": "1:424043770826:android:2423b7e09e8f3290ae5533",
            "ios": "1:424043770826:ios:47d76ca308c225ebae5533",
            "macos": "1:424043770826:ios:47d76ca308c225ebae5533",
            "web": "1:424043770826:web:e9c1995112bf1c0aae5533",
            "windows": "1:424043770826:web:8a37c297656410bcae5533"
          }
        }
      },
      "android": {
        "default": {
          "projectId": "autoproof-8d827",
