rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    function isSignedIn() {
      return request.auth != null;
    }

    function carSellerId(carId) {
      return get(/databases/$(database)/documents/cars/$(carId)).data.sellerId;
    }

    function chatParticipants(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // A chat carries three uid-keyed maps — who has read it, whose device has
    // it, and who has hidden it. Each entry is a statement about ONE person,
    // and only that person may make it.
    //
    // Without this a participant could write the other side's key and, with a
    // single field write: clear their unread badge so a message is never
    // noticed, or set `hiddenAt` for them and make the whole conversation
    // vanish from their list. `.get(field, {})` covers chats created before
    // any of these fields existed.
    function onlyMyEntry(field) {
      return request.resource.data.get(field, {})
             .diff(resource.data.get(field, {}))
             .affectedKeys()
             .hasOnly([request.auth.uid]);
    }

    function vehicleData(vehicleId) {
      return get(/databases/$(database)/documents/vehicles/$(vehicleId)).data;
    }

    // A buyer taking ownership must name the handover code they were given, in
    // `claimedVia`. The code is the transfer's document id, so a claim can only
    // be built by someone who was actually handed it. Repeated get()s of the
    // same path inside one evaluation are cached, so this costs a single read.
    function isValidClaim(vehicleId) {
      return request.resource.data.ownerId == request.auth.uid
             && resource.data.ownerId != request.auth.uid
             && request.resource.data.previousOwnerId == resource.data.ownerId
             && request.resource.data.isListed == false
             && request.resource.data.claimedVia is string
             && exists(/databases/$(database)/documents/transfers/$(request.resource.data.claimedVia))
             && transferData(request.resource.data.claimedVia).status == 'pending'
             && transferData(request.resource.data.claimedVia).vehicleId == vehicleId
             && transferData(request.resource.data.claimedVia).expiresAt > request.time;
    }

    function transferData(claimCode) {
      return get(/databases/$(database)/documents/transfers/$(claimCode)).data;
    }

    function attachedDocument(vehicleId, documentId) {
      return get(/databases/$(database)/documents/vehicles/$(vehicleId)/documents/$(documentId)).data;
    }

    // ---- Users (profile + saved cars) ----
    // A user can only read and write their own profile document.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // Saved cars live under the owner and are private to them.
      match /saved/{carId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Cars this user has handed on. Written at sale time and kept here
      // because it cannot be reconstructed afterwards: a passport is readable
      // only by its current owner, and `transfers` cannot be listed at all
      // (the document ids are the handover codes).
      match /past_vehicles/{vehicleId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- Cars (public marketplace listings) ----
    // Anyone may browse listings (even before signing in). Only the seller
    // who owns a listing may create, edit, or remove it.
    match /cars/{carId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if isSignedIn()
                    && resource.data.sellerId == request.auth.uid;

      // ---- The plate ----
      // `cars/{carId}` itself is world-readable, so the plate cannot live in
      // it: an app that stars the number out on screen while serving it in
      // the document is protecting nobody. It lives here instead, readable
      // and writable only by the seller who owns the listing.
      //
      // What a buyer sees instead is `govSnapshot` on the listing — the
      // registry's ANSWER, carrying neither the plate nor the VIN.
      match /private/{docId} {
        allow read, write: if isSignedIn()
                           && carSellerId(carId) == request.auth.uid;
      }

      // A buyer likes a car — the doc is keyed by the buyer's uid.
      match /buyer_likes/{buyerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == buyerId;
      }

      // The seller likes back a specific buyer — only the car's owner writes.
      match /seller_likes/{buyerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
                     && request.auth.uid == carSellerId(carId);
      }

      // Buyer journey progress — private to each buyer (keyed by their uid).
      match /journeys/{uid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Visitor notes — public to read (the whole point is transparency). Any
      // signed-in user may add one as themselves; only its author may delete it
      // (not even the seller can censor a note).
      match /notes/{noteId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.authorUid == request.auth.uid;
      }

    }

    // ---- Driver-reported diesel prices, per fuel station ----
    //
    // Israel publishes no per-station fuel price, so this is the only source
    // there is. Public read (the whole point is the shared tally); the doc is
    // keyed by the reporter's uid, so a driver can write, replace and delete
    // exactly one report per station and nobody else's.
    //
    // The price bounds are enforced HERE and not only in the client: a client
    // check stops a typo, a rules check stops someone posting 0.01 ₪ to make a
    // station look cheap. 300–1500 agorot is 3–15 ₪ a litre.
    match /fuel_reports/{stationId}/reports/{uid} {
      allow read: if true;
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && request.resource.data.agorot is int
                   && request.resource.data.agorot >= 300
                   && request.resource.data.agorot <= 1500
                   && request.resource.data.at == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- Chats (private, participants only) ----
    match /chats/{chatId} {
      // `resource == null` lets a buyer safely `get()` a not-yet-created chat
      // (ensureChat reads before writing); a missing doc exposes no data.
      allow read: if isSignedIn()
                  && (resource == null
                      || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && onlyMyEntry('lastRead')
                    && onlyMyEntry('deliveredAt')
                    && onlyMyEntry('hiddenAt')
                    // Participants are fixed at creation. Nobody joins or is
                    // removed from a conversation after the fact.
                    && request.resource.data.participants == resource.data.participants;

      // Messages — readable by participants; a sender may only write as itself.
      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in chatParticipants(chatId);
        allow create: if isSignedIn()
                      && request.auth.uid in chatParticipants(chatId)
                      && request.resource.data.senderId == request.auth.uid;
      }
    }

    // ---- Plate history (cross-listing memory, keyed by plate) ----
    //
    // The document key IS a plate, and plates are visible on every car in
    // every street — so `allow read: if true` meant anyone could walk a car
    // park and build a price-and-mileage history for each vehicle they
    // photographed. Signing in is not much of a barrier, but it ends the
    // anonymous version of that, and buyers no longer read this at all: the
    // seller's app copies the relevant records onto the listing at publish
    // time (`plateHistorySnapshot`), which identifies nobody.
    //
    // Snapshots hold NO seller identity.
    match /plate_history/{plate}/snapshots/{snapshotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
    }

    // ---- Vehicle passports (private garage) ----
    //
    // A vehicle is NOT a listing. The doc itself is readable only by its
    // owner, because it carries what the owner paid for the car and who they
    // bought it from — handing a buyer the seller's purchase price would be
    // arming one side of a negotiation. What the buyer is entitled to see is
    // the service history, so it is the `services` subcollection, and only
    // that, which opens up while the car is listed.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.serviceCount == 0;

      // Two ways a vehicle may change:
      //   1. its owner edits it, and ownership stays put;
      //   2. a buyer claims it with a valid handover code.
      // `serviceCount` may only hold or rise by one, so nobody can award
      // themselves a "תיק מתועד" badge without actually writing the records.
      allow update: if isSignedIn()
                    && (request.resource.data.serviceCount == resource.data.serviceCount
                        || request.resource.data.serviceCount == resource.data.serviceCount + 1)
                    && (
                      (resource.data.ownerId == request.auth.uid
                       && request.resource.data.ownerId == resource.data.ownerId)
                      || isValidClaim(vehicleId)
                    );

      // Only an empty passport can be deleted. Once one record exists,
      // "delete and re-add" would be an eraser, and append-only would mean
      // nothing.
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && resource.data.serviceCount == 0;

      // ---- Service records: append-only, no exceptions ----
      // Readable by the owner always, and by anyone while the car is listed —
      // a history the buyer cannot read cannot persuade them of anything.
      match /services/{serviceId} {
        // The listed check comes first so it short-circuits for a guest:
        // the marketplace is browsable without an account, and evaluating
        // `request.auth.uid` with no auth would deny the read instead.
        allow read: if vehicleData(vehicleId).isListed == true
                    || (isSignedIn()
                        && vehicleData(vehicleId).ownerId == request.auth.uid);
        allow create: if isSignedIn()
                      && vehicleData(vehicleId).ownerId == request.auth.uid
                      && request.resource.data.addedByOwnerId == request.auth.uid;
        // ---- Editable since 25/08, deletable never ----
        //
        // The owner may fix a record they entered: typos happen, and the
        // correction flow — a second record pointing at the first — was more
        // machinery than the problem needed. What an edit may NOT do is change
        // whose record it is or when it entered the history, and it must stamp
        // itself, so a buyer reading the log can see which entries were
        // changed after the fact.
        //
        // Deletion stays closed. Editing a wrong figure and erasing an
        // inconvenient service are different acts: the first leaves a history
        // that is still a history.
        allow update: if isSignedIn()
                      && vehicleData(vehicleId).ownerId == request.auth.uid
                      && request.resource.data.addedByOwnerId == resource.data.addedByOwnerId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.editedAt is timestamp;
        allow delete: if false; // never
      }

      match /reminders/{reminderId} {
        allow read, write: if isSignedIn()
                           && vehicleData(vehicleId).ownerId == request.auth.uid;
      }

      // ---- Running costs: private, and editable ----
      // Fuel, washes, parking. The owner's own budget, never a buyer's
      // business — so unlike the service history this stays shut even while
      // the car is listed, and unlike the service history it can be fixed.
      match /expenses/{expenseId} {
        allow read, write: if isSignedIn()
                           && vehicleData(vehicleId).ownerId == request.auth.uid;
      }

      // ---- Attached documents: private unless the owner shares them ----
      // A vehicle licence carries an ID number and a home address. Nothing
      // here reaches a buyer until the owner turns sharing on for that one
      // document, and only while the car is actually listed.
      match /documents/{documentId} {
        allow read: if (resource.data.isSharedWithBuyers == true
                        && vehicleData(vehicleId).isListed == true)
                    || (isSignedIn()
                        && vehicleData(vehicleId).ownerId == request.auth.uid);
        allow create: if isSignedIn()
                      && vehicleData(vehicleId).ownerId == request.auth.uid
                      && request.resource.data.uploadedByOwnerId == request.auth.uid;
        allow update, delete: if isSignedIn()
                              && vehicleData(vehicleId).ownerId == request.auth.uid;

        // ---- The file itself ----
        //
        // The bytes live in their own document, one level down, for two
        // reasons. Listing the drawer would otherwise download every scan in
        // it — the owner's list view reads metadata only, and a licence is
        // most of a megabyte. And a Firestore document is capped at 1 MiB
        // TOTAL, so bytes sharing a document with the title and the sharing
        // flag would shrink the picture to pay for them.
        //
        // The read rule is the parent's, restated: rules are not inherited by
        // subcollections, and a file readable when its record is not would
        // make the sharing switch decorative. `get()` on the parent costs one
        // read, and repeated gets inside one evaluation are cached.
        //
        // Unlike a Storage download URL, this genuinely revokes: there is no
        // token, so turning sharing off closes the door on anyone who has not
        // already saved the image to their own device.
        match /file/{fileId} {
          allow read: if (attachedDocument(vehicleId, documentId).isSharedWithBuyers == true
                          && vehicleData(vehicleId).isListed == true)
                      || (isSignedIn()
                          && vehicleData(vehicleId).ownerId == request.auth.uid);
          allow write: if isSignedIn()
                       && vehicleData(vehicleId).ownerId == request.auth.uid;
        }
      }
    }

    // ---- Ownership handover ----
    //
    // The document id IS the six-character claim code, and that is the whole
    // security model: `get` is allowed, `list` is not, so a signed-in stranger
    // can neither enumerate pending handovers nor find a code they were not
    // handed. Storing the code in a field as well would give it away.
    //
    // The claim writes only two things — who claimed it, and that it is
    // claimed. It cannot rewrite which vehicle or whose car it was.
    match /transfers/{claimCode} {
      allow get: if isSignedIn();
      allow list: if false;

      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.toUserId == null;

      allow update: if isSignedIn()
                    && resource.data.status == 'pending'
                    && resource.data.expiresAt > request.time
                    && resource.data.fromUserId != request.auth.uid
                    && request.resource.data.status == 'claimed'
                    && request.resource.data.toUserId == request.auth.uid
                    && request.resource.data.fromUserId == resource.data.fromUserId
                    && request.resource.data.vehicleId == resource.data.vehicleId
                    && request.resource.data.plate == resource.data.plate;

      allow delete: if false;
    }

    // ---- Note reports (flags for admin review; no client reads) ----
    match /note_reports/{reportId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
    }

    // ---- Correction requests ("this information is wrong") ----
    // Admin-review only. Anyone signed in may ask for a correction — including
    // a seller challenging community reports about their own listing.
    match /data_corrections/{requestId} {
      allow read: if false;
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
    }

    // ---- Garages and car washes ----
    //
    // The directory the app did not have. **Inspection centres are NOT here**
    // — they ship as an asset from Ministry of Transport data and have their
    // own screen, and a second copy would drift from the official one.
    //
    // Public read: the whole point is that a buyer can look a garage up.
    match /places/{placeId} {
      allow read: if true;

      // Everything written from the app is community-added. There is no path
      // that mints an entry claiming to be on an official register.
      allow create: if isSignedIn()
                    && request.resource.data.source == 'community'
                    && request.resource.data.addedByUid == request.auth.uid
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.isHidden == false;

      // Only the aggregates and the hidden flag, and only within bounds.
      //
      // **Spark has no Cloud Functions, so the counters are maintained by the
      // client** — which means the rules, not the code, are the only thing
      // standing between a rating and whoever wants to move it. They cannot
      // check the arithmetic, but they can stop one write from doing real
      // damage: a rating is 1..5, so a single update may move the count by at
      // most one and the sum by at most five.
      //
      // What this does NOT prevent is somebody looping. That is the reason the
      // app must never present a community rating as a verdict, and why the
      // average stays hidden below three reviews.
      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['ratingCount', 'ratingSum', 'ratingAvg',
                                   'lastReviewAt', 'isHidden'])
                    && request.resource.data.ratingCount >= resource.data.ratingCount
                    && request.resource.data.ratingCount <= resource.data.ratingCount + 1
                    && request.resource.data.ratingSum >= resource.data.ratingSum - 5
                    && request.resource.data.ratingSum <= resource.data.ratingSum + 5
                    // Hiding is one-way. An entry three people said does not
                    // exist cannot be un-hidden by the fourth.
                    && (resource.data.isHidden == false
                        || request.resource.data.isHidden == true);

      // Never. A place with reviews on it is a record other people wrote.
      allow delete: if false;

      // One review per person, keyed by their uid so the database enforces it.
      match /reviews/{reviewUid} {
        allow read: if true;
        allow create, update: if isSignedIn()
                              && request.auth.uid == reviewUid
                              && request.resource.data.rating is int
                              && request.resource.data.rating >= 1
                              && request.resource.data.rating <= 5
                              && (!('text' in request.resource.data)
                                  || request.resource.data.text.size() <= 500);
        // Yours to withdraw. Unlike a service record, a review is an opinion
        // about somebody else's business and nobody is owed its permanence.
        allow delete: if isSignedIn() && request.auth.uid == reviewUid;
      }
    }

    // ---- "This place does not exist" ----
    //
    // **The spec asked for a write-only top-level `place_reports`, and that
    // cannot work.** Three reports hide a place, and with no Cloud Functions
    // the counting happens on the device that files the third one — which
    // means it has to be able to READ the reports to count them. A collection
    // that is `allow read: if false` cannot be counted by the client that is
    // told to count it.
    //
    // So the reports live under the place, keyed by reporter, and are
    // readable. What that reveals is which places were reported and by how
    // many uids — not names, not reasons about people. Keying by uid also
    // does the job a top-level collection could not: one report per person,
    // enforced by the database, so nobody hides a rival by filing three.
    match /places/{placeId}/reports/{reporterUid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == reporterUid
                    && request.resource.data.reason is string;
      // A report stands. Withdrawing one after it has hidden a place would
      // leave the place hidden with nothing on record explaining why.
      allow update, delete: if false;
    }

    // ---- Retired collections ----
    // `reviews` collected anonymous feedback that no client could ever read,
    // so it gathered personal data with no purpose — the feature is gone and
    // writes are now refused.
    // `inspectors` / `bookings` backed a mock paid-booking flow that was never
    // implemented; the inspection-centre directory comes from data.gov.il.
    match /reviews/{reviewId} {
      allow read, write: if false;
    }
    match /inspectors/{inspectorId} {
      allow read, write: if false;
    }
    match /bookings/{bookingId} {
      allow read, write: if false;
    }
  }
}
