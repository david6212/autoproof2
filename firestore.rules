rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ----
    // The operator. Paired with email_verified on purpose: an unverified
    // email in a token is a claim the account made about itself, and this
    // grants read access to other people's complaints.
    function isOperator() {
      return request.auth != null
             && request.auth.token.email_verified == true
             && request.auth.token.email == 'davidmalede@gmail.com';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function carSellerId(carId) {
      return get(/databases/$(database)/documents/cars/$(carId)).data.sellerId;
    }

    function chatParticipants(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // A chat carries three uid-keyed maps — who has read it, whose device has
    // it, and who has hidden it. Each entry is a statement about ONE person,
    // and only that person may make it.
    //
    // Without this a participant could write the other side's key and, with a
    // single field write: clear their unread badge so a message is never
    // noticed, or set `hiddenAt` for them and make the whole conversation
    // vanish from their list. `.get(field, {})` covers chats created before
    // any of these fields existed.
    function onlyMyEntry(field) {
      return request.resource.data.get(field, {})
             .diff(resource.data.get(field, {}))
             .affectedKeys()
             .hasOnly([request.auth.uid]);
    }

    function vehicleData(vehicleId) {
      return get(/databases/$(database)/documents/vehicles/$(vehicleId)).data;
    }

    // A buyer taking ownership must name the handover code they were given, in
    // `claimedVia`. The code is the transfer's document id, so a claim can only
    // be built by someone who was actually handed it. Repeated get()s of the
    // same path inside one evaluation are cached, so this costs a single read.
    function isValidClaim(vehicleId) {
      return request.resource.data.ownerId == request.auth.uid
             && resource.data.ownerId != request.auth.uid
             && request.resource.data.previousOwnerId == resource.data.ownerId
             && request.resource.data.isListed == false
             && request.resource.data.claimedVia is string
             && exists(/databases/$(database)/documents/transfers/$(request.resource.data.claimedVia))
             && transferData(request.resource.data.claimedVia).status == 'pending'
             && transferData(request.resource.data.claimedVia).vehicleId == vehicleId
             && transferData(request.resource.data.claimedVia).expiresAt > request.time
             // The code must have been minted by the person who owns the car
             // RIGHT NOW. Without this line the whole model is decorative: a
             // stranger reads `vehicleId` off any public listing, mints a
             // transfer naming that vehicle with themselves as `fromUserId`,
             // and claims a passport they never owned — three writes, no app.
             && transferData(request.resource.data.claimedVia).fromUserId
                == resource.data.ownerId;
    }

    // ---- Account erasure ----
    //
    // Signals that this person is deleting their account, not editing their
    // data: `AccountDeletionRepository` removes `users/{uid}` FIRST, then
    // works through everything the account owns.
    //
    // This exists because two deliberate designs collided. Service history is
    // append-only so a seller cannot erase an inconvenient record while a
    // buyer is reading it; the right to erasure says a person may take their
    // data with them when they leave. Both are right, and the difference
    // between them is exactly whether the account still exists.
    //
    // It cannot be used to launder a history: reaching this state costs the
    // attacker their entire account, which is a far higher price than the
    // record they wanted gone.
    function isErasingAccount() {
      return isSignedIn()
             && !exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function transferData(claimCode) {
      return get(/databases/$(database)/documents/transfers/$(claimCode)).data;
    }

    function attachedDocument(vehicleId, documentId) {
      return get(/databases/$(database)/documents/vehicles/$(vehicleId)/documents/$(documentId)).data;
    }

    // ---- Users (profile + saved cars) ----
    // A user can only read and write their own profile document.
    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;

      // Saved cars live under the owner and are private to them.
      match /saved/{carId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Cars this user has handed on. Written at sale time and kept here
      // because it cannot be reconstructed afterwards: a passport is readable
      // only by its current owner, and `transfers` cannot be listed at all
      // (the document ids are the handover codes).
      match /past_vehicles/{vehicleId} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ---- Cars (public marketplace listings) ----
    // Anyone may browse listings (even before signing in). Only the seller
    // who owns a listing may create, edit, or remove it.
    // What a buyer is asked to trust on a listing — the registry's answer, the
    // documentation badge, the service count — used to be whatever the seller
    // wrote. Ownership was the entire validation.
    //
    // Two of the three can now be checked against something the seller does
    // not control: `vehicles/{id}` guards its own `serviceCount` (it may only
    // hold or rise by one) and its own service dates, so a listing that claims
    // a documented history has to point at a passport that actually has one.
    //
    // `govSnapshot` cannot be checked here at all — a rule cannot call
    // data.gov.il — so it is frozen after create instead: a seller cannot
    // publish honestly and then rewrite the registry's answer. Making it
    // unforgeable in the first place needs the lookup to happen somewhere the
    // seller is not, which needs a server, which needs Blaze.
    // **`getAfter`, not `get`** — the state the passport will be in once this
    // write commits.
    //
    // This is the whole of SEC-20, and it cost the product its signature
    // feature for two days. `addService` writes the record, the passport's
    // counters and the live listing's denormalised copy in ONE batch. `get()`
    // reads the passport as it was *before* that batch, so it returned the old
    // `serviceCount` while the listing carried old + 1. The two could never be
    // equal, the listing write was denied, and because a batch is atomic the
    // service record went down with it: **an owner could not log a service on
    // any car that was actually on the market.**
    //
    // Safe on create as well as update. `getAfter` on a document the write does
    // not touch returns exactly what `get` would, it costs the same single
    // read, and it is cached for the rest of the evaluation.
    function vehicleAfter(vehicleId) {
      return getAfter(/databases/$(database)/documents/vehicles/$(vehicleId)).data;
    }

    // The same rule `Vehicle.hasDocumentedHistory` applies, in the one place
    // the client cannot edit: three records, spanning at least six months.
    function documentedByRecord(v) {
      return v.get('serviceCount', 0) >= 3
             && 'firstServiceAt' in v
             && 'lastServiceAt' in v
             && v.lastServiceAt.toMillis() - v.firstServiceAt.toMillis()
                >= 15552000000;
    }

    function claimsMatchThePassport(d) {
      return !('vehicleId' in d)
          // No passport behind it: it may not claim one.
          ? (d.get('hasDocumentedHistory', false) == false
             && d.get('serviceCount', 0) == 0)
          : (d.get('serviceCount', 0) == vehicleAfter(d.vehicleId).get('serviceCount', 0)
             && d.get('hasDocumentedHistory', false)
                == documentedByRecord(vehicleAfter(d.vehicleId)));
    }

    // On update the claims may also simply stay as they are. Freezing rather
    // than re-proving keeps a price edit on an older listing from being
    // refused because of data written before this rule existed.
    function claimsUnchanged(before, after) {
      return after.get('hasDocumentedHistory', false)
               == before.get('hasDocumentedHistory', false)
             && after.get('serviceCount', 0) == before.get('serviceCount', 0)
             && after.get('historySpanMonths', 0)
                == before.get('historySpanMonths', 0);
    }

    match /cars/{carId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid
                    && claimsMatchThePassport(request.resource.data)
                    // A registry answer is stamped when it is taken, and a
                    // listing published today cannot have been checked
                    // tomorrow.
                    && (!('govCheckedAt' in request.resource.data)
                        || request.resource.data.govCheckedAt <= request.time);

      allow update: if isSignedIn()
                    && resource.data.sellerId == request.auth.uid
                    // The listing cannot be handed to somebody else, and its
                    // age cannot be reset — retention counts from it.
                    && request.resource.data.sellerId == resource.data.sellerId
                    && request.resource.data.createdAt == resource.data.createdAt
                    // The registry's answer is what it was at publication.
                    && request.resource.data.get('govSnapshot', {})
                       == resource.data.get('govSnapshot', {})
                    && (claimsUnchanged(resource.data, request.resource.data)
                        || claimsMatchThePassport(request.resource.data));

      allow delete: if isSignedIn()
                    && resource.data.sellerId == request.auth.uid;

      // ---- The plate ----
      // `cars/{carId}` itself is world-readable, so the plate cannot live in
      // it: an app that stars the number out on screen while serving it in
      // the document is protecting nobody. It lives here instead, readable
      // and writable only by the seller who owns the listing.
      //
      // What a buyer sees instead is `govSnapshot` on the listing — the
      // registry's ANSWER, carrying neither the plate nor the VIN.
      match /private/{docId} {
        allow read, write: if isSignedIn()
                           && carSellerId(carId) == request.auth.uid;
      }

      // A buyer likes a car — the doc is keyed by the buyer's uid.
      match /buyer_likes/{buyerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == buyerId;
      }

      // The seller likes back a specific buyer — only the car's owner writes.
      match /seller_likes/{buyerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn()
                     && request.auth.uid == carSellerId(carId);
      }

      // Buyer journey progress — private to each buyer (keyed by their uid).
      match /journeys/{uid} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }

      // Visitor notes — public to read (the whole point is transparency). Any
      // signed-in user may add one as themselves; only its author may delete it
      // (not even the seller can censor a note).
      match /notes/{noteId} {
        allow read: if true;
        allow create: if isSignedIn()
                      && request.resource.data.authorUid == request.auth.uid;
        allow delete: if isSignedIn()
                      && resource.data.authorUid == request.auth.uid;
      }

    }

    // ---- Driver-reported diesel prices, per fuel station ----
    //
    // Israel publishes no per-station fuel price, so this is the only source
    // there is. Public read (the whole point is the shared tally); the doc is
    // keyed by the reporter's uid, so a driver can write, replace and delete
    // exactly one report per station and nobody else's.
    //
    // The price bounds are enforced HERE and not only in the client: a client
    // check stops a typo, a rules check stops someone posting 0.01 ₪ to make a
    // station look cheap. 300–1500 agorot is 3–15 ₪ a litre.
    match /fuel_reports/{stationId}/reports/{uid} {
      allow read: if true;
      allow write: if isSignedIn()
                   && request.auth.uid == uid
                   && request.resource.data.agorot is int
                   && request.resource.data.agorot >= 300
                   && request.resource.data.agorot <= 1500
                   && request.resource.data.at == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---- Chats (private, participants only) ----
    match /chats/{chatId} {
      // `resource == null` lets a buyer safely `get()` a not-yet-created chat
      // (ensureChat reads before writing); a missing doc exposes no data.
      allow read: if isSignedIn()
                  && (resource == null
                      || request.auth.uid in resource.data.participants);
      allow create: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants;
      allow update: if isSignedIn()
                    && request.auth.uid in resource.data.participants
                    && onlyMyEntry('lastRead')
                    && onlyMyEntry('deliveredAt')
                    && onlyMyEntry('hiddenAt')
                    // Participants are fixed at creation. Nobody joins or is
                    // removed from a conversation after the fact.
                    && request.resource.data.participants == resource.data.participants;

      // Messages — readable by participants; a sender may only write as itself.
      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in chatParticipants(chatId);
        // Append-only stays — a marketplace conversation that either side can
        // rewrite is not evidence of anything. What was missing is a ceiling.
        //
        // Without one a participant could write up to Firestore's own 1 MiB
        // limit per message, and the other side's app streams the whole
        // conversation on open: a few hundred of those make the thread slow to
        // load and are a cheap way to spend this project's entire daily read
        // quota. 2,000 characters is longer than anything anybody types here
        // and shorter than anything worth abusing.
        allow create: if isSignedIn()
                      && request.auth.uid in chatParticipants(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.get('text', '') is string
                      && request.resource.data.get('text', '').size() <= 2000;
      }
    }

    // ---- Plate history (cross-listing memory, keyed by plate) ----
    //
    // The document key IS a plate, and plates are visible on every car in
    // every street — so `allow read: if true` meant anyone could walk a car
    // park and build a price-and-mileage history for each vehicle they
    // photographed. Signing in is not much of a barrier, but it ends the
    // anonymous version of that, and buyers no longer read this at all: the
    // seller's app copies the relevant records onto the listing at publish
    // time (`plateHistorySnapshot`), which identifies nobody.
    //
    // Snapshots hold NO seller identity.
    // Every field is checked, because nothing here can be taken back: there
    // is no update and no delete, and a snapshot is copied verbatim onto a
    // world-readable listing at publish time. An unvalidated create let anyone
    // who could read a plate off a windscreen plant a past for that car —
    // and since 27/08 a forged record raises THREE findings on the victim's
    // own page, one of which drags a real third party's listing into it.
    //
    // The `get()` on the listing is the load-bearing clause: it binds a
    // snapshot to a car the writer actually published. Safe to require —
    // `create_listing_provider` writes the listing before the snapshot, so the
    // document is already there. `createdAt` is pinned to server time because
    // a backdated snapshot is what invents a "dealer flip".
    match /plate_history/{plate}/snapshots/{snapshotId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.km is int
                    && request.resource.data.km >= 0
                    && request.resource.data.km <= 2000000
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && request.resource.data.sellerType in ['private', 'agent', 'dealer']
                    && request.resource.data.carId is string
                    && carSellerId(request.resource.data.carId) == request.auth.uid;
      allow update, delete: if false;
    }

    // ---- Vehicle passports (private garage) ----
    //
    // A vehicle is NOT a listing. The doc itself is readable only by its
    // owner, because it carries what the owner paid for the car and who they
    // bought it from — handing a buyer the seller's purchase price would be
    // arming one side of a negotiation. What the buyer is entitled to see is
    // the service history, so it is the `services` subcollection, and only
    // that, which opens up while the car is listed.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      // ---- The counters a "תיק מתועד" badge is computed from ----
      //
      // `serviceCount`, `firstServiceAt` and `lastServiceAt` are what
      // `documentedByRecord` reads, and through `claimsMatchThePassport` what
      // a listing's badge is checked against. Until 05/10 the rule only said
      // the count may "hold or rise by one" — per write. Three bare updates
      // and a back-dated `firstServiceAt` produced a documented passport with
      // no record behind it, and the listing check then faithfully confirmed
      // the forgery. A rule that compares a claim to a counter is only as
      // honest as the counter.
      //
      // Now the count may rise only together with the record that justifies
      // it: the write names the record in `lastServiceId`, the record did not
      // exist before this write and does after (so one record buys exactly
      // one increment, never a replay), and the dates are the ones that
      // record implies. While the count holds, the dates cannot move at all.
      //
      // What this cannot check: the record's own `date` is the owner's word.
      // Every record is on the timeline the buyer reads, so a back-dated
      // service is at least a visible claim rather than an invisible counter.
      function newServiceAfter() {
        return getAfter(/databases/$(database)/documents/vehicles/$(vehicleId)/services/$(request.resource.data.lastServiceId)).data;
      }

      function serviceCountedHonestly() {
        let before = resource.data;
        let after = request.resource.data;
        let first0 = before.get('firstServiceAt', null);
        let last0 = before.get('lastServiceAt', null);
        return after.serviceCount == before.serviceCount
            ? !after.diff(before).affectedKeys()
                .hasAny(['firstServiceAt', 'lastServiceAt', 'lastServiceId'])
            : (after.serviceCount == before.serviceCount + 1
               && after.get('lastServiceId', null) is string
               && !exists(/databases/$(database)/documents/vehicles/$(vehicleId)/services/$(after.lastServiceId))
               && existsAfter(/databases/$(database)/documents/vehicles/$(vehicleId)/services/$(after.lastServiceId))
               && newServiceAfter().date is timestamp
               && after.get('lastServiceAt', null)
                  == ((last0 == null || newServiceAfter().date > last0)
                      ? newServiceAfter().date : last0)
               && after.get('firstServiceAt', null)
                  == ((before.serviceCount == 0 || first0 == null)
                      ? newServiceAfter().date : first0));
      }

      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.serviceCount == 0
                    // An empty passport has no history to date.
                    && request.resource.data.get('firstServiceAt', null) == null
                    && request.resource.data.get('lastServiceAt', null) == null;

      // Two ways a vehicle may change:
      //   1. its owner edits it, and ownership stays put;
      //   2. a buyer claims it with a valid handover code.
      // `serviceCount` may only hold, or rise by one with the record that
      // earns it — see `serviceCountedHonestly`.
      allow update: if isSignedIn()
                    && serviceCountedHonestly()
                    && (
                      (resource.data.ownerId == request.auth.uid
                       && request.resource.data.ownerId == resource.data.ownerId)
                      || isValidClaim(vehicleId)
                    );

      // Only an empty passport can be deleted. Once one record exists,
      // "delete and re-add" would be an eraser, and append-only would mean
      // nothing.
      //
      // The exception is account erasure. Without it this gate silently won
      // the argument: "delete my account" ran a plain `.delete()`, Firestore
      // refused it on any documented vehicle, and the licence scan, the
      // service history and the plate all stayed behind — while the privacy
      // policy told the user they were gone.
      allow delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid
                    && (resource.data.serviceCount == 0 || isErasingAccount());

      // ---- Service records: append-only, no exceptions ----
      // Readable by the owner always, and by anyone while the car is listed —
      // a history the buyer cannot read cannot persuade them of anything.
      // The receipt image itself. **No `isListed` branch, deliberately.** The
      // record above is readable to a buyer because a service history is what
      // a passport is for; the invoice behind it carries a name and often an
      // address, and until 26/09 it was a tokenised Storage URL sitting in
      // that world-readable record — public, and not revoked by closing the
      // listing. The bytes live here now, beside the licence scans.
      match /services/{serviceId}/file/{blobId} {
        allow read, write: if isSignedIn()
                           && vehicleData(vehicleId).ownerId == request.auth.uid;
      }

      match /services/{serviceId} {
        // The listed check comes first so it short-circuits for a guest:
        // the marketplace is browsable without an account, and evaluating
        // `request.auth.uid` with no auth would deny the read instead.
        allow read: if vehicleData(vehicleId).isListed == true
                    || (isSignedIn()
                        && vehicleData(vehicleId).ownerId == request.auth.uid);
        allow create: if isSignedIn()
                      && vehicleData(vehicleId).ownerId == request.auth.uid
                      && request.resource.data.addedByOwnerId == request.auth.uid;
        // ---- Editable since 25/08, deletable never ----
        //
        // The owner may fix a record they entered: typos happen, and the
        // correction flow — a second record pointing at the first — was more
        // machinery than the problem needed. What an edit may NOT do is change
        // whose record it is or when it entered the history, and it must stamp
        // itself, so a buyer reading the log can see which entries were
        // changed after the fact.
        //
        // Deletion stays closed. Editing a wrong figure and erasing an
        // inconvenient service are different acts: the first leaves a history
        // that is still a history.
        allow update: if isSignedIn()
                      && vehicleData(vehicleId).ownerId == request.auth.uid
                      && request.resource.data.addedByOwnerId == resource.data.addedByOwnerId
                      && request.resource.data.createdAt == resource.data.createdAt
                      && request.resource.data.editedAt is timestamp;
        // Never while the account exists — see `isErasingAccount()`. A record
        // that could vanish while a buyer was reading it would make the whole
        // history worthless; a record that outlives the person who wrote it
        // makes "delete my account" a lie. This is the only gap between them.
        allow delete: if isErasingAccount()
                      && vehicleData(vehicleId).ownerId == request.auth.uid;
      }

      match /reminders/{reminderId} {
        allow read, write: if isSignedIn()
                           && vehicleData(vehicleId).ownerId == request.auth.uid;
      }

      // ---- Running costs: private, and editable ----
      // Fuel, washes, parking. The owner's own budget, never a buyer's
      // business — so unlike the service history this stays shut even while
      // the car is listed, and unlike the service history it can be fixed.
      match /expenses/{expenseId} {
        allow read, write: if isSignedIn()
                           && vehicleData(vehicleId).ownerId == request.auth.uid;
      }

      // ---- Attached documents: private unless the owner shares them ----
      // A vehicle licence carries an ID number and a home address. Nothing
      // here reaches a buyer until the owner turns sharing on for that one
      // document, and only while the car is actually listed.
      //
      // **And never to a signed-out stranger.** The rest of the marketplace is
      // deliberately browsable without an account — `services` short-circuits
      // for a guest on purpose. This is the one place that exception must not
      // reach: a shared licence read anonymously is an Israeli ID number and a
      // home address published to the open internet, which Google Play forbids
      // outright, with no exception for the owner having consented. Requiring
      // a sign-in does not make the document private, but it stops it being
      // *public*, and that word is what the rule turns on.
      match /documents/{documentId} {
        allow read: if (isSignedIn()
                        && resource.data.isSharedWithBuyers == true
                        && vehicleData(vehicleId).isListed == true)
                    || (isSignedIn()
                        && vehicleData(vehicleId).ownerId == request.auth.uid);
        allow create: if isSignedIn()
                      && vehicleData(vehicleId).ownerId == request.auth.uid
                      && request.resource.data.uploadedByOwnerId == request.auth.uid;
        allow update, delete: if isSignedIn()
                              && vehicleData(vehicleId).ownerId == request.auth.uid;

        // ---- The file itself ----
        //
        // The bytes live in their own document, one level down, for two
        // reasons. Listing the drawer would otherwise download every scan in
        // it — the owner's list view reads metadata only, and a licence is
        // most of a megabyte. And a Firestore document is capped at 1 MiB
        // TOTAL, so bytes sharing a document with the title and the sharing
        // flag would shrink the picture to pay for them.
        //
        // The read rule is the parent's, restated: rules are not inherited by
        // subcollections, and a file readable when its record is not would
        // make the sharing switch decorative. `get()` on the parent costs one
        // read, and repeated gets inside one evaluation are cached.
        //
        // Unlike a Storage download URL, this genuinely revokes: there is no
        // token, so turning sharing off closes the door on anyone who has not
        // already saved the image to their own device.
        match /file/{fileId} {
          allow read: if (isSignedIn()
                          && attachedDocument(vehicleId, documentId).isSharedWithBuyers == true
                          && vehicleData(vehicleId).isListed == true)
                      || (isSignedIn()
                          && vehicleData(vehicleId).ownerId == request.auth.uid);
          allow write: if isSignedIn()
                       && vehicleData(vehicleId).ownerId == request.auth.uid;
        }
      }
    }

    // ---- Ownership handover ----
    //
    // The document id IS the six-character claim code, and that is the whole
    // security model: `get` is allowed, `list` is not, so a signed-in stranger
    // can neither enumerate pending handovers nor find a code they were not
    // handed. Storing the code in a field as well would give it away.
    //
    // The claim writes only two things — who claimed it, and that it is
    // claimed. It cannot rewrite which vehicle or whose car it was.
    match /transfers/{claimCode} {
      allow get: if isSignedIn();
      allow list: if false;

      // `fromUserId == uid` says who is handing the car over; it does NOT say
      // the car is theirs. The `get()` does. And `expiresAt` is written by the
      // client, so it is bounded here too — an unbounded expiry turns a
      // handover code into a permanent key. The slack over `validFor` (14d)
      // absorbs a client clock that runs fast.
      allow create: if isSignedIn()
                    && request.resource.data.fromUserId == request.auth.uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.toUserId == null
                    && vehicleData(request.resource.data.vehicleId).ownerId
                       == request.auth.uid
                    && request.resource.data.expiresAt
                       <= request.time + duration.value(15, 'd');

      allow update: if isSignedIn()
                    && resource.data.status == 'pending'
                    && resource.data.expiresAt > request.time
                    && resource.data.fromUserId != request.auth.uid
                    && request.resource.data.status == 'claimed'
                    && request.resource.data.toUserId == request.auth.uid
                    && request.resource.data.fromUserId == resource.data.fromUserId
                    && request.resource.data.vehicleId == resource.data.vehicleId
                    && request.resource.data.plate == resource.data.plate;

      allow delete: if false;
    }

    // ---- Note reports (flags for admin review; no client reads) ----
    // Readable by the operator, and by nobody else. It used to be readable by
    // no one at all — including the person whose published complaints
    // procedure promises an answer within 14 days. A report of a defamatory
    // note landed here and waited for somebody to remember to open a console.
    match /note_reports/{reportId} {
      allow read: if isOperator();
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
      // Marking one handled writes a timestamp and nothing else: the report
      // itself is the record of what was said, and an operator who can edit
      // complaints about their own product can edit the evidence.
      allow update: if isOperator()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['handledAt']);
      allow delete: if false;
    }

    // ---- Review reports ("this review is false or defamatory") ----
    //
    // Top level, beside note_reports and data_corrections, rather than under
    // the place: the operator reads all three from one inbox, and a nested
    // collection would need a collection-group query and a recursive rule to
    // do the same.
    //
    // One per person per review. The id ends in the reporter's uid, so a
    // second report from the same account is an update, and is refused.
    // ---- Professional escorts: people who will look at a car with a buyer ----
    //
    // The feature ships OFF (`AppConfig.escortEnabled`), and these rules ship
    // with it: a collection with no rules is a collection with no protection
    // the day somebody flips a flag.
    //
    // **The trust fields are operator-only, and that is the whole design.**
    // There is no server here, so a rule cannot ask the Ministry whether a
    // licence number is real. An applicant writes what they claim; the
    // operator looks the number up and writes what was found. If a client
    // could write `garageLicence`, every applicant would arrive wearing the
    // register's badge.
    match /escort_pros/{proId} {
      // Readable by anyone: a buyer choosing who to bring to a viewing is
      // browsing, and browsing does not need an account here any more than the
      // listings do. What is readable is a display name, an area and a price —
      // the phone number is not in this document.
      allow read: if true;

      allow create: if isSignedIn()
                    && proId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                         'displayName', 'town', 'areas', 'priceIls', 'about',
                         'yearsExperience', 'declaresInsurance',
                         'claimedLicence', 'certStatus', 'createdAt'])
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() > 1
                    && request.resource.data.priceIls is int
                    && request.resource.data.priceIls >= 0
                    && request.resource.data.priceIls <= 5000
                    // A new profile may only declare a certificate pending or
                    // absent. "approved" is the operator's word.
                    && request.resource.data.certStatus in ['none', 'pending'];

      // The owner edits their own details. Everything a buyer trusts —
      // the registry trio, the certificate's verdict and date, the hidden
      // flag, the rating aggregates — is missing from this list on purpose.
      allow update: if isSignedIn()
                    && proId == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'town', 'areas', 'priceIls',
                                   'about', 'yearsExperience',
                                   'declaresInsurance', 'claimedLicence',
                                   'certStatus'])
                    && request.resource.data.priceIls is int
                    && request.resource.data.priceIls >= 0
                    && request.resource.data.priceIls <= 5000
                    // An owner may withdraw a certificate or resubmit one;
                    // they may not approve it.
                    && request.resource.data.certStatus in ['none', 'pending']
                    && resource.data.certStatus != 'approved';

      // The operator writes the verdict, and may hide a profile after a
      // complaint. Hiding, never deleting: the record of what was published
      // is what a complaint is judged against.
      allow update: if isOperator()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['certStatus', 'certCheckedAt',
                                   'garageLicence', 'garageName', 'garageTown',
                                   'isHidden', 'hiddenAt']);

      allow delete: if false;
    }

    // The applications queue, under the same fourteen-day promise as every
    // other inbox collection — same shape, same `handledAt`, same locks.
    match /pro_applications/{applicationId} {
      allow read: if isOperator();
      allow create: if isSignedIn()
                    && applicationId == request.auth.uid
                    && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isOperator()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['handledAt']);
      allow delete: if false;
    }

    match /review_reports/{reportId} {
      allow read: if isOperator();
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid
                    && reportId.matches('.*__' + request.auth.uid);
      allow update: if isOperator()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['handledAt']);
      allow delete: if false;
    }

    // ---- Correction requests ("this information is wrong") ----
    // Admin-review only. Anyone signed in may ask for a correction — including
    // a seller challenging community reports about their own listing.
    match /data_corrections/{requestId} {
      allow read: if isOperator();
      allow create: if isSignedIn()
                    && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isOperator()
                    && request.resource.data.diff(resource.data)
                         .affectedKeys().hasOnly(['handledAt']);
      allow delete: if false;
    }

    // ---- Garages and car washes ----
    //
    // The directory the app did not have. **Inspection centres are NOT here**
    // — they ship as an asset from Ministry of Transport data and have their
    // own screen, and a second copy would drift from the official one.
    //
    // Public read: the whole point is that a buyer can look a garage up.
    match /places/{placeId} {
      allow read: if true;

      // Everything written from the app is community-added. There is no path
      // that mints an entry claiming to be on an official register.
      allow create: if isSignedIn()
                    && request.resource.data.source == 'community'
                    && request.resource.data.addedByUid == request.auth.uid
                    && request.resource.data.ratingCount == 0
                    && request.resource.data.ratingSum == 0
                    && request.resource.data.isHidden == false
                    && request.resource.data.get('reportCount', 0) == 0;

      // ---- SEC-01: the score is the sum of the reviews, exactly ----
      //
      // Until 05/10 a move of the aggregates only had to come with the
      // caller's review EXISTING after the write — existence, not novelty.
      // One honest review, then N bare updates of +1/+5, each satisfying every
      // clause, drove any garage to 5.0 (or, holding the count, to 1.0). And
      // the review document could be created, edited or deleted on its own,
      // so create-5 / edit-to-1 / delete netted +4 with the count unchanged.
      //
      // Now both sides are bound, and the arithmetic is exact:
      //   * a NEW review (absent before, present after) adds one to the count
      //     and exactly its rating to the sum;
      //   * an EDIT keeps the count and moves the sum by new − old;
      //   * a WITHDRAWAL (present before, absent after) removes one and
      //     exactly the old rating — unless the operator had hidden it, in
      //     which case its rating already left and must not leave twice.
      // The review rules below demand the mirror image, so neither half can
      // be written without the other. `saveReview` and `deleteReview` already
      // write both in one batch, so the installed client passes unchanged.
      //
      // `ratingAvg` is left unchecked on purpose: the rules' `/` on two ints
      // is integer division while the client's is a double, and the app never
      // reads the stored field (`Place.ratingAvg` is computed from sum/count).
      function aggregatesFollowOwnReview() {
        let before = resource.data;
        let after = request.resource.data;
        let r = /databases/$(database)/documents/places/$(placeId)/reviews/$(request.auth.uid);
        let had = exists(r);
        let has = existsAfter(r);
        return (!had && has)
            ? (after.ratingCount == before.ratingCount + 1
               && after.ratingSum == before.ratingSum + getAfter(r).data.rating)
            : (had && has)
            ? (get(r).data.get('hiddenByOperator', false) != true
               && after.ratingCount == before.ratingCount
               && after.ratingSum
                  == before.ratingSum + getAfter(r).data.rating - get(r).data.rating)
            : (had && !has)
            ? (get(r).data.get('hiddenByOperator', false) != true
               && after.ratingCount == before.ratingCount - 1
               && after.ratingSum == before.ratingSum - get(r).data.rating)
            : false;
      }

      // ---- SEC-02: three distinct reporters, counted where they can't lie ----
      //
      // Until 05/10 hiding needed only a report in the caller's own name —
      // which the caller writes. Two writes removed any garage, permanently.
      // The "three strangers" threshold lived only in the client, and a REST
      // client does not run the client.
      //
      // Rules cannot count documents, so the count is a field they CAN check:
      // `reportCount` rises by exactly one, and only beside a report that did
      // not exist before this write and does after. Reports are keyed by uid
      // and can never be withdrawn or rewritten, so each account moves it
      // once, ever. `isHidden` may turn true only once it reads three.
      function reportCountFollowsOwnReport() {
        let rep = /databases/$(database)/documents/places/$(placeId)/reports/$(request.auth.uid);
        return request.resource.data.reportCount
                 == resource.data.get('reportCount', 0) + 1
               && !exists(rep)
               && existsAfter(rep);
      }

      allow update: if isSignedIn()
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['ratingCount', 'ratingSum', 'ratingAvg',
                                   'lastReviewAt', 'isHidden', 'reportCount'])
                    && request.resource.data.ratingCount >= 0
                    // Coarse bounds that hold for EVERYONE, the operator
                    // included: one review is one vote of 1..5, so no single
                    // write moves more than that. The exact arithmetic below
                    // implies them for a reviewer; they stay because the
                    // operator path skips it, and a slip there should cost one
                    // review's worth of score, not a garage.
                    && request.resource.data.ratingCount <= resource.data.ratingCount + 1
                    && request.resource.data.ratingCount >= resource.data.ratingCount - 1
                    && request.resource.data.ratingSum >= resource.data.ratingSum - 5
                    && request.resource.data.ratingSum <= resource.data.ratingSum + 5
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['ratingCount', 'ratingSum'])
                        || isOperator()
                        || aggregatesFollowOwnReview())
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['reportCount'])
                        || reportCountFollowsOwnReport())
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['isHidden'])
                        || isOperator()
                        || (request.resource.data.isHidden == true
                            && request.resource.data.get('reportCount', 0) >= 3))
                    // Hiding is one-way. An entry three people said does not
                    // exist cannot be un-hidden by the fourth.
                    && (resource.data.isHidden == false
                        || request.resource.data.isHidden == true
                        // ...except for the operator, who is the only way back
                        // from a hide that turns out to be wrong. Without this
                        // a mistaken removal was permanent, console-only.
                        || isOperator());

      // Never. A place with reviews on it is a record other people wrote.
      allow delete: if false;

      // One review per person, keyed by their uid so the database enforces it.
      match /reviews/{reviewUid} {
        allow read: if true;

        // The mirror of `aggregatesFollowOwnReview`: a review cannot be
        // written, changed or withdrawn without the place moving by exactly
        // what it contributes. Without this half, the review alone could be
        // created and deleted around a single aggregate write, and each loop
        // left the score a little further from the truth.
        function placeMovesBy(countDelta, sumDelta) {
          let p = /databases/$(database)/documents/places/$(placeId);
          return getAfter(p).data.ratingCount == get(p).data.ratingCount + countDelta
                 && getAfter(p).data.ratingSum == get(p).data.ratingSum + sumDelta;
        }

        allow create: if isSignedIn()
                      && request.auth.uid == reviewUid
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && (!('text' in request.resource.data)
                          || request.resource.data.text.size() <= 500)
                      // Nobody arrives pre-hidden, and nobody hides their own.
                      && !('hiddenByOperator' in request.resource.data)
                      && placeMovesBy(1, request.resource.data.rating);

        // The author may edit — but not a review the operator has hidden.
        // saveReview writes the whole document, so without this an edit to a
        // hidden review would silently drop the flag and put it back on
        // screen: the very review somebody reported, restored by its author.
        allow update: if isSignedIn()
                      && request.auth.uid == reviewUid
                      && resource.data.get('hiddenByOperator', false) != true
                      && !('hiddenByOperator' in request.resource.data)
                      && request.resource.data.rating is int
                      && request.resource.data.rating >= 1
                      && request.resource.data.rating <= 5
                      && (!('text' in request.resource.data)
                          || request.resource.data.text.size() <= 500)
                      && placeMovesBy(0, request.resource.data.rating
                                         - resource.data.rating);

        // The operator may hide or restore, and change nothing else. The words
        // stay exactly as written, so a report that turns out to be wrong can
        // be undone with what the review actually said still intact.
        allow update: if isOperator()
                      && request.resource.data.diff(resource.data).affectedKeys()
                           .hasOnly(['hiddenByOperator', 'hiddenAt']);

        // Yours to withdraw, hidden or not: an opinion about somebody else's
        // business, nobody is owed its permanence, and erasing it is the
        // author's right.
        //
        // A hidden review's rating already left the aggregate when it was
        // hidden, so it goes alone; any other takes its rating with it.
        allow delete: if isSignedIn() && request.auth.uid == reviewUid
                      && (resource.data.get('hiddenByOperator', false) == true
                          || placeMovesBy(-1, -resource.data.rating));
      }

    }

    // ---- "This place does not exist" ----
    //
    // **The spec asked for a write-only top-level `place_reports`, and that
    // cannot work.** Three reports hide a place, and with no Cloud Functions
    // the counting happens on the device that files the third one — which
    // means it has to be able to READ the reports to count them. A collection
    // that is `allow read: if false` cannot be counted by the client that is
    // told to count it.
    //
    // So the reports live under the place, keyed by reporter, and are
    // readable. What that reveals is which places were reported and by how
    // many uids — not names, not reasons about people. Keying by uid also
    // does the job a top-level collection could not: one report per person,
    // enforced by the database, so nobody hides a rival by filing three.
    match /places/{placeId}/reports/{reporterUid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.auth.uid == reporterUid
                    && request.resource.data.reason is string
                    // Filed together with the counter it moves — see
                    // `reportCountFollowsOwnReport`. A report that does not
                    // count would let the threshold drift from the reports.
                    && getAfter(/databases/$(database)/documents/places/$(placeId)).data.get('reportCount', 0)
                       == get(/databases/$(database)/documents/places/$(placeId)).data.get('reportCount', 0) + 1;
      // A report stands. Withdrawing one after it has hidden a place would
      // leave the place hidden with nothing on record explaining why.
      allow update, delete: if false;
    }

    // ---- Retired collections ----
    // `reviews` collected anonymous feedback that no client could ever read,
    // so it gathered personal data with no purpose — the feature is gone and
    // writes are now refused.
    // `inspectors` / `bookings` backed a mock paid-booking flow that was never
    // implemented; the inspection-centre directory comes from data.gov.il.
    match /reviews/{reviewId} {
      allow read, write: if false;
    }
    match /inspectors/{inspectorId} {
      allow read, write: if false;
    }
    match /bookings/{bookingId} {
      allow read, write: if false;
    }
  }
}
