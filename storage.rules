rules_version = '2';

// **What this file governs today: listing photos, and nothing else.**
//
// Until 26/09 it also held vehicle-passport documents (a licence carries an ID
// number and a home address) and service receipts. Both moved INTO Firestore,
// as bytes in a document one level below their record —
// `vehicles/{id}/documents/{docId}/file/*` and
// `vehicles/{id}/services/{sid}/file/blob` — for two reasons that held then
// and hold now: it works on the free plan, which has no bucket, and a Firestore
// read is checked against the rules on every request, so unsharing a document
// really revokes it. A Storage download URL carries its own access token,
// served by an endpoint that never consults these rules; once copied, it works
// until the file is deleted.
//
// The two passport blocks below are therefore RESERVED AND UNUSED: no code
// writes to those paths. They stay, owner-only, so that a future change which
// does write there inherits the right answer instead of the deny-all default
// being mistaken for an oversight and opened up.
//
// Storage rules cannot read Firestore, so they cannot ask "does this user own
// that vehicle?" — the only thing they can check is the path, which is why
// every path starts with the uploader's uid. In Storage rules `read` covers
// `get` and `list` together, so a public read on a prefix is also a public
// directory listing of it.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function withinSizeLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ---- Listing photos ----
    // Public read, and here that is the right answer: a listing photo is
    // published on purpose, the marketplace is browsable before signing in,
    // and the prefix holds nothing but the photos of one public listing.
    match /cars/{uid}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && withinSizeLimit(10)
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // ---- Vehicle passport documents — RESERVED, UNUSED since 26/09 ----
    // The bytes are in Firestore now; see the header. Owner only regardless.
    match /vehicles/{uid}/{vehicleId}/documents/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && withinSizeLimit(10)
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid);
    }

    // ---- Service receipts — RESERVED, UNUSED since 26/09 ----
    // In Firestore at `services/{sid}/file/blob`; see the header. A garage
    // invoice carries a name, a plate and often an address: owner only.
    match /vehicles/{uid}/{vehicleId}/receipts/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && withinSizeLimit(10)
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid);
    }

    // Anything not named above is refused. Without this a default-open bucket
    // is a free file host for anyone with an account.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
