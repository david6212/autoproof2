rules_version = '2';

// Storage rules cannot read Firestore, so they cannot ask "does this user own
// that vehicle?". The only thing they can check is the path — which is why
// every path below starts with the uploader's uid.
//
// **Read is not how a buyer sees a file.** A Firebase download URL carries its
// own access token and is served by an endpoint that does not consult these
// rules at all. That token is what shows a listing photo or a shared document.
// The `allow read` lines below govern something else entirely: reading and
// *listing* by path with the SDK. In Storage rules `read` covers `get` and
// `list` together, so a public read on a prefix is also a public directory
// listing of it.
//
// That is why the passport paths are owner-only. A רישיון רכב carries an ID
// number and a home address; `firestore.rules` keeps its record shut until the
// owner shares it and the car is listed, and the file has to be at least as
// shut as the record. A buyer who is allowed to see the document reads the
// URL off that Firestore record; nobody can walk `vehicles/{uid}/` to find one
// they were never given.
//
// Known limitation, deliberate: an access token, once copied, keeps working
// until the file is deleted — unsharing hides a document in the app but does
// not revoke a link somebody already has. `DocumentRepository.deleteDocument`
// deletes the file and not just the record, and the delete dialog says so.
// Replacing the token with a short-lived signed URL needs a server, which
// needs Cloud Functions.
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function withinSizeLimit(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // ---- Listing photos ----
    // Public read, and here that is the right answer: a listing photo is
    // published on purpose, the marketplace is browsable before signing in,
    // and the prefix holds nothing but the photos of one public listing.
    match /cars/{uid}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid)
                   && withinSizeLimit(10)
                   && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid);
    }

    // ---- Vehicle passport documents ----
    // Owner only. Images and PDFs — a passport is not a file host.
    match /vehicles/{uid}/{vehicleId}/documents/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && withinSizeLimit(10)
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid);
    }

    // ---- Service receipts ----
    // Owner only, for the same reason: a garage invoice carries a name, a
    // plate and often an address, and no screen ever fetches one by path.
    match /vehicles/{uid}/{vehicleId}/receipts/{fileName} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
                   && withinSizeLimit(10)
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType == 'application/pdf');
      allow delete: if isOwner(uid);
    }

    // Anything not named above is refused. Without this a default-open bucket
    // is a free file host for anyone with an account.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
